# --- GitHub App credentials -------------------------------------------------
# Create the App at https://github.com/settings/apps and install it on a repo.
GITHUB_APP_ID=
# The downloaded .pem. Literal newlines or \n escapes both work.
GITHUB_PRIVATE_KEY=
# The webhook secret you set on the App.
GITHUB_WEBHOOK_SECRET=

# Trigger handle (default @crabsweeper) and HTTP port.
# CRABSWEEPER_MENTION=@crabsweeper
# PORT=8000

# Local dev: your smee channel. scripts/dev.sh relays it to /webhook.
SMEE_URL=

# --- Model provider ---------------------------------------------------------
# Default provider is OpenRouter.
CRABSWEEPER_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini

# opencode router (or any OpenAI-compatible gateway): set the base URL and key.
# CRABSWEEPER_LLM_PROVIDER=opencode
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Route by diff size: cheap/free for small diffs, stronger for large ones.
# LLM_MODEL_SMALL=auto
# LLM_MODEL_LARGE=gpt-6-luna
# LLM_SIZE_THRESHOLD=400

# Per-run budget.
# CRABSWEEPER_MAX_COST_USD=0.10
# LLM_MAX_OUTPUT_TOKENS=1200
# Send OpenRouter's per-request price cap too (opt-in).
# CRABSWEEPER_ENFORCE_MAX_PRICE=true
